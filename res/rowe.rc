// Resources of rowe.dll and rowe_launcher.exe, included by rowe_dll.rc / rowe_launcher.rc with
// ROWE_FILE set to the file's name and ROWE_DESC to its description; ROWE_EXE adds the icon and the
// manifest.
#include <winver.h>
#include "version.h"

#ifdef ROWE_EXE
1 ICON "rowe.ico"
1 24 "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION ROWE_VERSION_NUM
PRODUCTVERSION ROWE_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
#ifdef ROWE_EXE
FILETYPE VFT_APP
#else
FILETYPE VFT_DLL
#endif
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ROWE_COMPANY
            VALUE "FileDescription", ROWE_DESC
            VALUE "FileVersion", ROWE_VERSION_STR
            VALUE "InternalName", ROWE_FILE
            VALUE "LegalCopyright", ROWE_COPYRIGHT
            VALUE "OriginalFilename", ROWE_FILE
            VALUE "ProductName", ROWE_PRODUCT
            VALUE "ProductVersion", ROWE_VERSION_STR
            VALUE "Comments", ROWE_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
